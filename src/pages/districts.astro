---
import Page from '../layouts/Page.astro';
import { districtsAbout, districts } from '../lib/mirror-data';
import { linkify } from '../lib/links';
import Rich from '../components/Rich.astro';

const seen = new Set<string>();

const idOf = (name: string) => name.toLowerCase().replace(/&/g, 'and').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const faqs = [
  { q: 'What is an AA district?', a: 'A district is a geographical division within an area that gives the groups in that vicinity a voice in matters affecting other groups and AA as a whole. Each district has a District Committee made up of representatives from its groups.' },
  { q: 'What is a GSR?', a: 'A General Service Representative (GSR) is the member a group elects to attend district meetings and Area Assemblies and to represent the group’s conscience.' },
  { q: 'What is a DCM?', a: 'A District Committee Member (DCM) is an experienced GSR elected by the district to link the groups’ GSRs with the Area Delegate and the area committee.' },
  { q: 'How do I find out which district I am in?', a: 'Use the “What District am I in?” link on this page, or email info@aaemass.org.' },
];
---

<Page
  title="AA Districts in Eastern Massachusetts | Area 30"
  description="Find when and where each Area 30 district meets in Eastern Massachusetts, how to join online, and where to mail contributions."
  heading="Districts"
  eyebrow="Area 30"
  lede="Districts give the groups in each part of Eastern Massachusetts a voice in matters that affect AA as a whole."
  faqs={faqs}
  current="/districts"
>
  <section class="section" aria-labelledby="what-title">
    <div class="wrap prose stack">
      <h2 id="what-title">What are Districts?</h2>
      {districtsAbout.paras.map((p) => <p><Rich text={p} seen={seen} /></p>)}
      <p>
        <a class="button button--quiet" href={districtsAbout.link.href}>{districtsAbout.link.text}</a>
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="meet-title">
    <div class="wrap">
      <div class="stack prose" style="margin-block-end: var(--s-5)">
        <h2 id="meet-title">Where and when does each district meet?</h2>
        <nav aria-label="Districts">
          <ul class="inline-list">
            {districts.map((d) => <li><a href={`#${idOf(d.name)}`}>{d.name.replace('District ', '')}</a></li>)}
          </ul>
        </nav>
      </div>
      <ul class="district-grid">
        {districts.map((d) => (
          <li class="notice stack anchor" id={idOf(d.name)}>
            <h3>{d.name}</h3>
            {d.lines.map((l) => <p set:html={linkify(l)} />)}
          </li>
        ))}
      </ul>
    </div>
  </section>
</Page>
