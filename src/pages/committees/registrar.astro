---
import Page from '../../layouts/Page.astro';
import Rich from '../../components/Rich.astro';
import { site, path } from '../../lib/site';

const forms = [
  { title: 'New Group Form', text: 'Fill this out to register a new group.', href: path('/forms/new-group-form.pdf') },
  { title: 'Group Update Form', text: 'Update your group’s information.', href: path('/forms/group-update-form.pdf') },
  { title: 'DCM Change Form', text: 'Report a change of District Committee Member.', href: path('/forms/dcm-change-form.pdf') },
  { title: 'Updated Group Change Form', text: 'Fillable group change form (Word document).', href: path('/forms/group-change-form.docx') },
];
const seen = new Set<string>();
const faqs = [
  { q: 'How do I register my AA group with Area 30?', a: 'Complete the New Group Form and email it to registrar@aaemass.org. Being listed on the Meeting Guide app or with Boston Central Service does not by itself register a group with Area 30 or the General Service Office.' },
  { q: 'Why does my group need a service number?', a: 'If you send a contribution to the General Service Office in New York without your group’s service number, your group will not get credit for the donation. The Registrar can look up your group’s number.' },
  { q: 'How do I update my group’s information or change a DCM?', a: 'Download the Group Update Form or the DCM Change Form below, complete it and email it to the Registrar.' },
  { q: 'What does the Area Registrar do?', a: 'The Registrar maintains the Confidential Area List, coordinates with the General Service Office, the Delegate and Districts on group updates, and manages the registration desk at Area Assemblies.' },
];
---

<Page
  title="Registrar: Register an AA Group | Area 30"
  description="Register your AA group with Area 30, update group or DCM information, and download the Registrar’s forms. Email registrar@aaemass.org."
  heading="Registrar"
  eyebrow="Standing committee"
  lede="We are here to assist with the registration process."
  faqs={faqs}
  current="/committees/registrar"
>
  <section class="section" aria-labelledby="number-title">
    <div class="wrap prose">
      <div class="notice stack">
        <h2 id="number-title" style="font-size: var(--step-1)">Does your group have a service number?</h2>
        <p>
          <Rich text="If you send a contribution to the General Service Office in New York without your group’s service number, your group will not get credit for the donation." seen={seen} /> If you are not
          sure, email <a href={`mailto:${site.registrarEmail}`}>{site.registrarEmail}</a> and we
          can help look up your group’s information.
        </p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="mission-title">
    <div class="wrap prose stack">
      <h2 id="mission-title">Mission</h2>
      <p>
        <Rich text="The Registrar maintains the Confidential Area List, coordinates with the General Service Office, the Delegate and Districts regarding group updates, and manages the registration desk at Area Assemblies." seen={seen} />
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="forms-title">
    <div class="wrap">
      <div class="stack prose" style="margin-block-end: var(--s-5)">
        <h2 id="forms-title">How do I register or update my group?</h2>
        <p>Download a form below, or email the Registrar to request one.</p>
      </div>
      <ul class="cards">
        {forms.map((f) => (
          <li class="notice stack">
            <h3>{f.title}</h3>
            <p>{f.text}</p>
            <a href={f.href}>Open form</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="help-title">
    <div class="wrap prose stack">
      <h2 id="help-title">How can we help?</h2>
      <p>
        Contact Area 30’s Registrar with any questions, form requests, or for additional
        information.
      </p>
      <p><a class="button" href={`mailto:${site.registrarEmail}`}>Email {site.registrarEmail}</a></p>
    </div>
  </section>
</Page>
