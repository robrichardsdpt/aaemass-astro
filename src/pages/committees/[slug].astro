---
import Page from '../../layouts/Page.astro';
import { path } from '../../lib/site';
import { committees } from '../../lib/committee-pages';
import { linkify } from '../../lib/links';
import { termify } from '../../lib/term-match';
import { site } from '../../lib/site';
import MessagePlaceholder from '../../components/ui/MessagePlaceholder.astro';
import { nextOccurrence, scheduleLd } from '../../lib/schedule';

export function getStaticPaths() {
  return Object.entries(committees).map(([slug, c]) => ({ params: { slug }, props: { slug, c } }));
}
const { slug, c } = Astro.props;
const url = `${site.url}/committees/${slug}/`;
const orgId = `${url}#committee`;
const extraLd: Record<string, unknown>[] = [
  {
    '@type': 'Organization',
    '@id': orgId,
    name: `${c.title} Committee, Area 30`,
    url,
    email: c.email,
    parentOrganization: { '@id': `${site.url}/#org` },
    contactPoint: { '@type': 'ContactPoint', contactType: `${c.title} Committee`, email: c.email },
  },
  ...(c.schedule
    ? [{
        '@type': 'Event',
        name: `${c.title} Committee meeting`,
        description: c.description,
        startDate: nextOccurrence(c.schedule),
        eventSchedule: scheduleLd(c.schedule),
        eventStatus: 'https://schema.org/EventScheduled',
        eventAttendanceMode: 'https://schema.org/OnlineEventAttendanceMode',
        location: { '@type': 'VirtualLocation', url },
        organizer: { '@id': orgId },
        isAccessibleForFree: true,
      }]
    : []),
];
const seen = new Set<string>();
const rich = (text: string) => termify(linkify(text), seen);
---

<Page
  title={c.seoTitle ?? `${c.title} Committee | Area 30 Eastern Mass. AA`}
  description={c.description}
  heading={c.title}
  eyebrow={c.eyebrow}
  lede={c.lede}
  current="/committees"
  extraLd={extraLd}
  trail={[{ name: 'Committees', href: '/committees' }]}
>
  <div slot="actions" class="actions">
    <a class="button" href={`mailto:${c.email}`}>Email the committee</a>
    <a class="button button--quiet" href={path('/committees')}>All committees</a>
  </div>

  {c.quote && (
    <section class="section">
      <div class="wrap prose">
        <blockquote class="quote">
          <p>“{c.quote.text}”</p>
          <footer>{c.quote.by}</footer>
        </blockquote>
      </div>
    </section>
  )}

  {c.sections.map((s, i) => (
    <section class="section" aria-labelledby={`s${i}`}>
      <div class="wrap prose stack">
        <h2 id={`s${i}`}>{s.title}</h2>
        {s.paras?.map((p) => <p set:html={rich(p)} />)}
        {s.items && <ul class="checklist">{s.items.map((x) => <li set:html={rich(x)} />)}</ul>}
        {s.links && <ul class="inline-list">{s.links.map((l) => <li><a href={l.href}>{l.text}</a></li>)}</ul>}
      </div>
    </section>
  ))}

  {c.meeting && (
    <section class="section" aria-labelledby="meeting-title">
      <div class="wrap prose">
        <div class="notice stack">
          <h2 id="meeting-title" style="font-size: var(--step-1)">When does the committee meet?</h2>
          {c.meeting.intro && <p>{c.meeting.intro}</p>}
          {c.meeting.chips && <ul class="inline-list">{c.meeting.chips.map((d) => <li><span class="chip">{d}</span></li>)}</ul>}
          {c.meeting.lines.map((l) => <p>{l}</p>)}
          <p style="display:flex;flex-wrap:wrap;gap:var(--s-3)">
            {c.meeting.join && <a class="button" href={c.meeting.join.href}>{c.meeting.join.text}</a>}
            {c.meeting.calendar && <a class="button button--quiet" href={path('/calendar')}>See the calendar</a>}
          </p>
        </div>
      </div>
    </section>
  )}

  <section class="section" aria-labelledby="contact-title">
    <div class="wrap prose stack">
      <h2 id="contact-title">How do I contact the committee?</h2>
      <p>{c.cta}</p>
      <p>
        <a class="button" href={`mailto:${c.email}`}>{c.email}</a>
      </p>
      {c.more && <p><a href={path(c.more.href)}>{c.more.text}</a></p>}
      <MessagePlaceholder id="committee" to={`the ${c.title} Committee`} email={c.email} />
    </div>
  </section>
</Page>
