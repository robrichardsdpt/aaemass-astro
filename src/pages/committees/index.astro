---
import { Image } from 'astro:assets';
import Page from '../../layouts/Page.astro';
import { path, committees, moreCommittees } from '../../lib/site';
import archives from '../../assets/home-archives.jpg';
import cpc from '../../assets/home-cpc.jpg';
import corrections from '../../assets/home-corrections.jpg';
import grapevine from '../../assets/home-grapevine.jpg';
import literature from '../../assets/home-literature.jpg';
import pi from '../../assets/home-pi.jpg';

const images = { archives, cpc, corrections, grapevine, literature, pi };
---

<Page
  title="Committees | Area 30 Eastern Massachusetts Alcoholics Anonymous"
  description="Area 30 conference and standing committees: Archives, C.P.C., Corrections, Grapevine, Literature, Public Information, Treatment Facilities, Accessibilities and more."
  heading="Committees"
  eyebrow="Service"
  lede="Committees carry the A.A. message to the people who meet alcoholics first. Every A.A. member is welcome to help."
  current="/committees"
>
  <section class="section" aria-labelledby="conf-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="conf-title">Conference committees</h2>
        <a href={path('/services')}>Read committee reports</a>
      </div>
      <ul class="committee-grid">
        {committees.map((c) => (
          <li>
            <Image src={images[c.image]} alt="" widths={[200, 300, 400]} sizes="(min-width: 64rem) 11rem, (min-width: 36rem) 30vw, 46vw" />
            <a href={c.href}>{'short' in c ? `${c.short} Committee` : `${c.name} Committee`}</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="more-title">
    <div class="wrap">
      <h2 id="more-title" style="margin-block-end: var(--s-4)">Also in Area 30</h2>
      <ul class="inline-list">
        {moreCommittees.map((c) => <li><a href={c.href}>{c.name}</a></li>)}
      </ul>
      <p class="prose" style="margin-block-start: var(--s-5)">
        Looking for an email address? The <a href={path('/contacts-new')}>contact page</a> lists
        every officer and committee.
      </p>
    </div>
  </section>
</Page>
