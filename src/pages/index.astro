---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { site, path, committees, moreCommittees } from '../lib/site';
import { getUpcomingEvents } from '../lib/events';
import { serviceSteps, faqs } from '../lib/content';
import Term from '../components/Term.astro';
import Rich from '../components/Rich.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteScripts from '../components/SiteScripts.astro';

import heroImg from '../assets/boston-2-bg.jpg';
import circleImg from '../assets/shutterstock_1555828898.png';
import handsImg from '../assets/shutterstock_1710141808.png';
import archives from '../assets/home-archives.jpg';
import cpc from '../assets/home-cpc.jpg';
import corrections from '../assets/home-corrections.jpg';
import grapevine from '../assets/home-grapevine.jpg';
import literature from '../assets/home-literature.jpg';
import pi from '../assets/home-pi.jpg';

const committeeImages = { archives, cpc, corrections, grapevine, literature, pi };

const seen = new Set<string>();
const events = await getUpcomingEvents(4);
const tz = 'America/New_York';
const day = new Intl.DateTimeFormat('en-US', { timeZone: tz, month: 'short', day: 'numeric' });
const clock = new Intl.DateTimeFormat('en-US', { timeZone: tz, weekday: 'long', hour: 'numeric', minute: '2-digit' });
---

<Base
  title="Alcoholics Anonymous in Eastern Massachusetts | Area 30"
  description="Area 30 is the Alcoholics Anonymous service area for Eastern Massachusetts. Find a meeting, register your group, see events and get involved in service."
  faqs={faqs}
>
  <SiteHeader />

  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <Image src={heroImg} alt="" widths={[640, 1024, 1600]} sizes="100vw" quality={55} loading="eager" fetchpriority="high" />
      <div class="wrap">
        <p class="eyebrow">Alcoholics Anonymous General Service Committee</p>
        <h1 id="hero-title">Alcoholics Anonymous in Eastern Massachusetts</h1>
        <p class="lede">
          Area 30 connects AA groups across the eastern half of the state to each other and to the
          General Service Office.
        </p>
        <div class="actions">
          <a class="button" href={site.links.findMeeting}>Find a meeting</a>
          <a class="button button--quiet" href={path('/cal')}>See the calendar</a>
        </div>
      </div>
    </section>

    <section class="signup" aria-labelledby="signup-title">
      <div class="wrap">
        <div>
          <h2 id="signup-title">Join the Area 30 mailing list</h2>
          <p>Periodic emails that keep members connected to what is happening in Area 30.</p>
        </div>
        {site.signupEndpoint ? (
          <form id="signup-form" method="post" action={site.signupEndpoint} novalidate>
            <div class="field">
              <label for="signup-email">Email address</label>
              <input id="signup-email" type="email" name="email" autocomplete="email" required />
            </div>
            <button class="button" type="submit">Sign up</button>
            <div class="hp" aria-hidden="true">
              <label>Leave this field empty if you are human<input type="text" name="_gotcha" value="" tabindex="-1" autocomplete="off" /></label>
            </div>
            <input type="hidden" name="_subject" value="Area 30 mailing list signup" />
          </form>
        ) : (
          <p>To join, email <a href={`mailto:${site.email}?subject=Area%2030%20mailing%20list`}>{site.email}</a>.</p>
        )}
      </div>
    </section>

    <section class="section" aria-labelledby="about-title">
      <div class="wrap split">
        <Image src={circleImg} alt="Members of an AA group seated in a circle, hands clasped." widths={[480, 731]} sizes="(min-width: 52rem) 40vw, 100vw" />
        <div class="stack prose">
          <h2 id="about-title">About Area 30</h2>
          <p><strong>We are the Alcoholics Anonymous General Service Committee of Eastern Massachusetts.</strong></p>
          <p>
            An area is a geographical division within a state or province. A General Service
            Conference <Term id="delegate" seen={seen}>Delegate</Term> comes from an area. Massachusetts has two: Eastern Mass. (Area 30)
            and Western Mass. (Area 31). The Delegate is your voice to the General Service Office,
            AA World Services and the Grapevine.
          </p>
          <p>
            Want a new piece of literature? Want to change an existing one? Have a suggestion for a
            better way to carry the message? Those decisions are made at the General Service
            Conference, and our Delegate speaks for us there.
          </p>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="register-title">
      <div class="wrap prose">
        <div class="notice stack">
          <h3 id="register-title">Is your group registered with Area 30?</h3>
          <p>
            Being listed on the Meeting Guide app or with Boston Central Service does not mean your
            group is registered with Area 30 or the General Service Office.
          </p>
          <p>
            To register, complete <a href={site.links.registerForm}>the group registration form</a>
            and email it to <a href={`mailto:${site.registrarEmail}`}>{site.registrarEmail}</a>.
            Groups that contribute to Area 30 or the General Service Office must be registered and
            include their ID number with each contribution. Those contributions carry the AA
            message to members in treatment, in correctional facilities and in remote communities,
            and to the professionals and public who meet alcoholics first.
          </p>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="website-title">
      <div class="wrap split split--flip">
        <Image src={handsImg} alt="A circle of people reaching their hands into the center, stacked together." widths={[480, 731]} sizes="(min-width: 52rem) 45vw, 100vw" />
        <div class="stack prose">
          <h2 id="website-title">About this website</h2>
          <p>
            The Area 30 Website Committee maintains this site for <Term id="gsr" seen={seen}>GSRs</Term>, committee members,
            officers and other AA members in the area.
          </p>
          <p>
            Questions about Area 30? Write to <a href={`mailto:${site.email}`}>{site.email}</a>.
          </p>
          <p>
            <a class="button button--quiet" href={site.links.areaFolder}>Area documents (Google Drive)</a>
          </p>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="service-title">
      <div class="wrap">
        <div class="stack prose" style="margin-block-end: var(--s-6)">
          <p class="eyebrow">Our Third Legacy</p>
          <h2 id="service-title">Get involved in service</h2>
          <p>
            AA members work together to help the alcoholic who still suffers, and helping each
            other is a key to staying sober. The best place to start is an AA group. When a
            person reaches out for help, a group makes sure AA is there.
          </p>
        </div>
        <ul class="paths">
          <li>
            <h3>AA groups</h3>
            <p>Meetings share experience and strength. Find one near you.</p>
            <a href={site.links.findMeeting}>Find a meeting<span class="visually-hidden"> on aa.org</span></a>
          </li>
          <li>
            <h3>AA service</h3>
            <p>
              Service committees focus outreach on one area: Corrections, Cooperation with the
              Professional Community, Literature, Accessibilities, Treatment, Public Information and Archives.
            </p>
            <a href={path('/services')}>Browse service committees</a>
          </li>
          <li>
            <h3>What is Alcoholics Anonymous?</h3>
            <p>Alcoholics Anonymous is a fellowship of people who come together to solve their drinking problem.</p>
            <a href={path('/alcoholics-anonymous')}>Read about Alcoholics Anonymous</a>
          </li>
        </ul>
      </div>
    </section>

    <section class="section" aria-labelledby="events-title">
      <div class="wrap prose">
        <div class="section-head">
          <h2 id="events-title">Upcoming events</h2>
          <a href={path('/cal')}>View the full calendar</a>
        </div>
        {events.length > 0 ? (
          <ul class="events">
            {events.map((e) => (
              <li>
                <time datetime={e.start.toISOString()}>{day.format(e.start)}</time>
                <div>
                  <a href={e.url}>{e.title}</a>
                  <p class="when">{e.allDay ? 'All day' : clock.format(e.start)}{e.venue ? `, ${e.venue}` : ''}</p>
                </div>
              </li>
            ))}
          </ul>
        ) : (
          <p>No events are posted right now. Committee meetings and area events appear on the calendar as they are scheduled.</p>
        )}
      </div>
    </section>

    <section class="section" aria-labelledby="committees-title">
      <div class="wrap">
        <div class="section-head">
          <h2 id="committees-title">Service committees</h2>
          <a href={path('/services')}>View all committees</a>
        </div>
        <ul class="committee-grid">
          {committees.map((c) => (
            <li>
              <Image src={committeeImages[c.image]} alt="" widths={[200, 300, 400]} sizes="(min-width: 64rem) 11rem, (min-width: 36rem) 30vw, 46vw" />
              <a href={c.href}>{'short' in c ? `${c.short} Committee` : `${c.name} Committee`}</a>
            </li>
          ))}
        </ul>
        <p class="eyebrow" style="margin-block: var(--s-6) var(--s-2)">Also in Area 30</p>
        <ul class="inline-list">
          {moreCommittees.map((c) => <li><a href={c.href}>{c.name}</a></li>)}
        </ul>
      </div>
    </section>

    <section class="section" aria-labelledby="how-title">
      <div class="wrap">
        <div class="stack prose" style="margin-block-end: var(--s-6)">
          <h2 id="how-title">How Alcoholics Anonymous service works</h2>
          <p>
            Alcoholics Anonymous groups are connected through a simple structure of general service.
            Each step is made up of members who volunteer and are elected by the step below.
          </p>
        </div>
        <ol class="steps">
          {serviceSteps.map((step) => (
            <li>
              <h3>{step.title}</h3>
              <p><Rich text={step.text} seen={seen} /></p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section" aria-labelledby="faq-title">
      <div class="wrap prose">
        <h2 id="faq-title" style="margin-block-end: var(--s-5)">Frequently asked questions</h2>
        <div class="faq">
          {faqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <div class="stack">
                <p><Rich text={f.a} seen={seen} /></p>
                {f.link && <p><a href={f.link.href}>{f.link.text}</a></p>}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>
    <section class="section" aria-labelledby="quick-title">
      <div class="wrap">
        <h2 id="quick-title" class="visually-hidden">Quick links</h2>
        <div class="quick">
          <div class="stack">
            <h3>Events</h3>
            <p>Area 30 events and committee meetings.</p>
            <a href={path('/cal')}>Calendar</a>
          </div>
          <div class="stack">
            <h3>Get in touch</h3>
            <p>Contact us and see the full list of officers and committee members.</p>
            <a href={path('/contacts-new')}>Contact Area 30</a>
          </div>
          <div class="stack">
            <h3>7th Tradition</h3>
            <p>Contribute to Area 30 as a member, group or district.</p>
            <a href={path('/contributions')}>Contributions</a>
          </div>
          <div class="stack">
            <h3>Links</h3>
            <p>Resources and useful Alcoholics Anonymous links.</p>
            <a href={path('/links')}>Resources</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />

  <div id="toast" class="toast" role="status" aria-live="polite" hidden></div>

  <SiteScripts />
  <script is:inline>
    // Mailing-list signup: send without leaving the page, then confirm with a toast.
    var form = document.getElementById('signup-form');
    var toast = document.getElementById('toast');
    var toastTimer;
    function showToast(message, isError) {
      toast.textContent = message;
      toast.dataset.state = isError ? 'error' : 'ok';
      toast.hidden = false;
      clearTimeout(toastTimer);
      toastTimer = setTimeout(function () { toast.hidden = true; }, 7000);
    }
    if (form && toast) {
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var email = form.elements.email;
        if (!email.value || !email.checkValidity()) {
          email.focus();
          showToast('Please enter a valid email address.', true);
          return;
        }
        var button = form.querySelector('button[type=submit]');
        button.disabled = true;
        fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } })
          .then(function (res) {
            if (!res.ok) throw new Error('bad status');
            form.reset();
            showToast('Thank you. We received your email and will add you to the mailing list.', false);
          })
          .catch(function () {
            showToast('Sorry, that did not go through. Please email info@aaemass.org instead.', true);
          })
          .finally(function () { button.disabled = false; });
      });
      toast.addEventListener('click', function () { toast.hidden = true; });
    }
  </script>
</Base>
