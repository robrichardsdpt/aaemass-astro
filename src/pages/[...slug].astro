---
// Pages created in the CMS (src/content/pages/<slug>.yml). Hand-built pages take precedence.
import { getCollection } from 'astro:content';
import CmsPage from '../views/CmsPage.astro';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages.map((p) => ({ params: { slug: p.id }, props: { page: p } }));
}
const { page } = Astro.props;
---

<CmsPage data={page.data} />
