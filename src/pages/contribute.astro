---
import Page from '../layouts/Page.astro';
import Rich from '../components/Rich.astro';
import { site } from '../lib/site';
import PlaceholderForm from '../components/ui/PlaceholderForm.astro';
import MessagePlaceholder from '../components/ui/MessagePlaceholder.astro';
import { districts } from '../lib/mirror-data';

const districtOptions = districts.map((d) => d.name);
const formAlt = (label: string) => ({ text: 'To contribute online today, use the secure form on aaemass.org:', href: live, label });
const toPayPal = 'After you submit, you will continue to PayPal’s secure payment page.';

const live = `${site.url}/contributions`;
const forms = [
  { title: 'Group contribution', text: 'Contribute to Area 30 as an AA group.', href: `${live}#GCF` },
  { title: 'Member contribution', text: 'Contribute as an individual AA member.', href: `${live}#MCF` },
  { title: 'District contribution', text: 'Contribute to Area 30 as a District.', href: `${live}#DCF` },
];
const gives = [
  'Groups get meeting space',
  'Phones get answered',
  'Alcoholic persons in custody get Big Books',
  'Professionals get correct information about AA.',
  'Lone AA members get letters',
  'Newcomers get literature and meeting lists',
  'AAs around the globe share experience, strength and hope',
];
const pamphlet = 'https://www.aa.org/self-support-where-money-and-spirituality-mix';
const seen = new Set<string>();
const faqs = [
  { q: 'Who can contribute to Area 30?', a: 'Only AA members, groups and districts. Area 30 respectfully declines contributions from non-AA members, in keeping with the Seventh Tradition and self-support.' },
  { q: 'What is the Seventh Tradition?', a: 'It states that every AA group ought to be fully self-supporting, declining outside contributions. Even AA members are limited in the amount they can contribute.' },
  { q: 'How do I contribute online?', a: 'Use the group, member or district form that matches who is giving. You will need your group number, which the Registrar can look up at registrar@aaemass.org.' },
  { q: 'What do contributions pay for?', a: 'Contributions help groups get meeting space, phones get answered, people in custody get Big Books, professionals get correct information about AA, lone members get letters and newcomers get literature and meeting lists.' },
];
---

<Page
  title="Contribute to Area 30 | Seventh Tradition"
  description="Contribute to Area 30 as an AA group, member or district. Learn how the Seventh Tradition keeps AA fully self-supporting."
  heading="Contributions and self-support"
  eyebrow="Seventh Tradition"
  lede="Every AA group ought to be fully self-supporting, declining outside contributions."
  faqs={faqs}
  current="/contribute"
>
  <div slot="actions" class="actions">
    <a class="button" href="#contribute">Contribute online</a>
    <a class="button button--quiet" href={pamphlet}>Read the pamphlet</a>
  </div>

  <section class="section" aria-labelledby="tradition-title">
    <div class="wrap prose stack">
      <h2 id="tradition-title">Contributions and self-support</h2>
      <p>
        AA’s <Rich text="Seventh Tradition" seen={seen} /> states: “Every AA group ought to be fully self-supporting,
        declining outside contributions.” This means that only AA members contribute financially
        to AA, and even AA members are limited in the amount they can contribute. This keeps
        AA free of outside influences that might divert us from our primary purpose: to help the
        alcoholic who still suffers. The amount of the contribution is secondary to the spiritual
        connection that unites all groups around the world.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="money-title">
    <div class="wrap split">
      <div class="stack prose">
        <h2 id="money-title">Where money and spirituality mix</h2>
        <p>
          Members celebrate sobriety by giving time, energy and money in support of carrying the
          AA message. Members assure that group expenses are paid by voluntarily putting money
          into the basket passed at each meeting. Contributions support the group and AA
          worldwide.
        </p>
        <p><a href={pamphlet}>Read the pamphlet on aa.org</a></p>
      </div>
      <div class="notice stack">
        <h3>Contributions ensure that</h3>
        <ul class="checklist">
          {gives.map((g) => <li>{g}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section" id="contribute" aria-labelledby="online-title">
    <div class="wrap">
      <div class="stack prose" style="margin-block-end: var(--s-5)">
        <h2 id="online-title">How do I contribute online?</h2>
        <p>
          Use the form that matches who is giving. If you do not know your group number, email
          <a href={`mailto:${site.registrarEmail}`}>{site.registrarEmail}</a>. A committee or a cluster
          of groups should use the District form and add details in the sub-district field. Questions
          about finances go to <a href="mailto:treasurer@aaemass.org">treasurer@aaemass.org</a>.
        </p>
      </div>
      <ul class="cards">
        {forms.map((f) => (
          <li class="notice stack card-link">
            <p class="eyebrow">Secure form on aaemass.org</p>
            <h3><a href={f.href}>{f.title}</a></h3>
            <p>{f.text}</p>
          </li>
        ))}
      </ul>
      <p class="prose" style="margin-block-start: var(--s-4)">
        These forms hand off to PayPal’s secure payment gateway on aaemass.org, so they stay on
        the live site until payments are moved over.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="mail-title">
    <div class="wrap prose stack">
      <h2 id="mail-title">Can I mail a contribution?</h2>
      <p>
        Yes. Send a check to <strong>General Service Committee of Eastern MA, PO Box 51411, Boston, MA 02205</strong>.
        Checks may be made payable to <strong>General Service Committee of Eastern MA</strong>. We appreciate your support!
      </p>
    </div>
  </section>

  <section class="section" id="coming-soon" aria-labelledby="soon-title">
    <div class="wrap">
      <div class="stack prose" style="margin-block-end: var(--s-5)">
        <h2 id="soon-title">Coming soon: contribute without leaving this site</h2>
        <p>
          These previews show the forms we plan to offer here. They are <strong>not functional yet</strong>,
          and the forms on aaemass.org above are the working way to give online.
        </p>
      </div>
      <div class="prose">
        <div class="faq">
          <details open>
            <summary>Group contribution <span class="badge-soon">Not functional yet</span></summary>
            <div class="stack">
              <PlaceholderForm
                id="grp"
                submitLabel="Continue to PayPal"
                alternative={formAlt('Group contribution form')}
                fields={[
                  { name: 'member', label: 'I am an AA member contributing on behalf of a group', type: 'checkbox', required: true },
                  { name: 'group', label: 'Group name', required: true, half: true },
                  { name: 'number', label: 'Group number', required: true, half: true, hint: 'Not sure? Email registrar@aaemass.org.' },
                  { name: 'street', label: 'Meeting location: street address' },
                  { name: 'town', label: 'Town', half: true },
                  { name: 'zip', label: 'ZIP code', half: true },
                  { name: 'email', label: 'Email address', type: 'email', required: true },
                  { name: 'day', label: 'Meeting day', type: 'select', options: ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'], required: true, half: true },
                  { name: 'time', label: 'Meeting time', type: 'time', required: true, half: true },
                  { name: 'amount', label: 'Amount', type: 'number', prefix: '$', required: true, hint: toPayPal },
                ]}
              />
            </div>
          </details>
          <details>
            <summary>Member contribution <span class="badge-soon">Not functional yet</span></summary>
            <div class="stack">
              <PlaceholderForm
                id="mem"
                submitLabel="Continue to PayPal"
                alternative={formAlt('Member contribution form')}
                fields={[
                  { name: 'member', label: 'I am an AA member contributing on behalf of myself (not a group or district)', type: 'checkbox', required: true },
                  { name: 'first', label: 'First name', required: true, half: true },
                  { name: 'last', label: 'Last name', required: true, half: true },
                  { name: 'street', label: 'Street address', required: true },
                  { name: 'town', label: 'Town', required: true, half: true },
                  { name: 'zip', label: 'ZIP code', required: true, half: true },
                  { name: 'email', label: 'Email address', type: 'email', required: true },
                  { name: 'amount', label: 'Amount', type: 'number', prefix: '$', required: true, hint: toPayPal },
                ]}
              />
            </div>
          </details>
          <details>
            <summary>District contribution <span class="badge-soon">Not functional yet</span></summary>
            <div class="stack">
              <PlaceholderForm
                id="dist"
                submitLabel="Continue to PayPal"
                alternative={formAlt('District contribution form')}
                fields={[
                  { name: 'member', label: 'I am an AA member contributing on behalf of a district', type: 'checkbox', required: true },
                  { name: 'district', label: 'District', type: 'select', options: districtOptions, required: true, hint: 'Use this form only when a district contributes to Area 30. Otherwise use the group or member form.' },
                  { name: 'subdistrict', label: 'Subdistrict', hint: 'For multiple groups or a committee, for example Martha’s Vineyard or MSCYPAA.' },
                  { name: 'email', label: 'Email address', type: 'email', required: true },
                  { name: 'amount', label: 'Amount', type: 'number', prefix: '$', required: true, hint: toPayPal },
                ]}
              />
            </div>
          </details>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="treasurer-title">
    <div class="wrap">
      <div class="stack prose" style="margin-block-end: var(--s-5)">
        <h2 id="treasurer-title">Questions about contributions?</h2>
        <p>Contact Area 30’s Treasurer with any questions.</p>
      </div>
      <div class="prose"><MessagePlaceholder id="treasurer" to="the Treasurer" email="treasurer@aaemass.org" /></div>
    </div>
  </section>

  <section class="section" aria-labelledby="non-title">
    <div class="wrap prose stack">
      <h2 id="non-title">Non-AA members</h2>
      <p>
        Area 30 respectfully declines contributions from non-AA members in accordance with our
        Seventh Tradition and self-support. If you are interested in learning more about our
        recovery program, please reach out.
      </p>
      <ul class="inline-list">
        <li><a href="mailto:cpc@aaemass.org">Professionals</a></li>
        <li><a href="mailto:pi@aaemass.org">Individuals and families</a></li>
        <li><a href="mailto:treasurer@aaemass.org">Questions on finances</a></li>
      </ul>
    </div>
  </section>
</Page>
