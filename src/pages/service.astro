---
import Page from '../layouts/Page.astro';
import { services } from '../lib/mirror-data';
import { linkify } from '../lib/links';
import { path } from '../lib/site';
import { committees } from '../lib/committee-pages';
import { termify } from '../lib/term-match';

const seen = new Set<string>();

// Short, stable anchors that the committee tiles on the home and committees pages link to.
const ids: Record<string, string> = {
  'Cooperation with the Professional Community': 'cpc',
  'Public Information Committee': 'public-information',
  'Joint Treatment Facilities': 'treatment-facilities',
};
const idOf = (title: string) => ids[title] ?? title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const sections = services.sections.map((s) => ({ ...s, id: idOf(s.title) }));
---

<Page
  title="Service in Area 30: Delegate, Committees, Reports"
  description="What the Delegate, Alternate Delegate, Secretary and each committee do in Area 30, when they meet and how to reach them."
  heading="Services"
  eyebrow="Get involved"
  lede="Opportunity abounds for Eastern Massachusetts AA members who want to take part in service beyond their home group."
  current="/committees"
>
  <section class="section" aria-labelledby="intro-title">
    <div class="wrap prose stack">
      <h2 id="intro-title" class="visually-hidden">About service in Area 30</h2>
      <p>
        The General Service Committee of Eastern Massachusetts, Area 30, supports the work of
        several varied committees, some whose reports can be read below. All members of Alcoholics
        Anonymous are welcome. Please consider making yourself available to help out where you can.
      </p>
      <p>
        A complete list of conference and standing committees, with a way to reach each one, is on
        the <a href={path('/contact')}>contact page</a>.
      </p>
      <nav aria-label="On this page" class="stack">
        <p class="eyebrow">Jump to</p>
        <ul class="inline-list">
          {sections.map((s) => <li><a href={`#${s.id}`}>{s.title}</a></li>)}
        </ul>
      </nav>
    </div>
  </section>

  {sections.map((s) => (
    <section class="section anchor" id={s.id} aria-labelledby={`${s.id}-title`}>
      <div class="wrap prose stack">
        <h2 id={`${s.id}-title`}>{s.title}</h2>
        {s.paras.map((p, i) => (
          <p set:html={termify(linkify(p), seen)} />
        ))}
        {(s.id in committees || s.id === 'registrar') && (
          <p><a href={path(s.id === 'registrar' ? '/committees/registrar' : `/committees/${s.id}`)}>Full {s.title} committee page</a></p>
        )}
        {s.contact && (
          <p><a class="button button--quiet" href={`mailto:${s.contact}`}>Email {s.contact}</a></p>
        )}
      </div>
    </section>
  ))}
</Page>
