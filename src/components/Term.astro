---
import type { TermId } from '../lib/content';
import { termDefs } from '../i18n/terms';
import { getLang } from '../i18n';
import { ui } from '../i18n/ui';

interface Props {
  id: TermId;
  // Shared across the page: only the first mention of each term becomes a popover.
  seen: Set<string>;
}
const { id, seen } = Astro.props;
const lang = getLang(Astro);
const term = termDefs[lang][id];
const first = !seen.has(id);
seen.add(id);
const popId = `term-${id}`;
---

{first ? <><button type="button" class="term" popovertarget={popId} aria-haspopup="dialog"><abbr title={term.full}><slot /></abbr></button><span id={popId} popover class="term-card" role="dialog" aria-label={term.full}><strong>{term.full}</strong><span>{term.def}</span><button type="button" class="term-close" popovertarget={popId} popovertargetaction="hide">{ui[lang].close}</button></span></> : <slot />}
