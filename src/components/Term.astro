---
import { terms, type TermId } from '../lib/content';

interface Props {
  id: TermId;
  // Shared across the page: only the first mention of each term becomes a popover.
  seen: Set<string>;
}
const { id, seen } = Astro.props;
const term = terms[id];
const first = !seen.has(id);
seen.add(id);
const popId = `term-${id}`;
---

{first ? <><button type="button" class="term" popovertarget={popId} aria-haspopup="dialog"><abbr title={term.full}><slot /></abbr></button><span id={popId} popover class="term-card" role="dialog" aria-label={term.full}><strong>{term.full}</strong><span>{term.def}</span><button type="button" class="term-close" popovertarget={popId} popovertargetaction="hide">Close</button></span></> : <slot />}
