---
// Date column plus title and time. Used on the home page, calendar and event blocks.
import type { AreaEvent } from '../../lib/events';
import { getLang, htmlLang } from '../../i18n';
import { ui } from '../../i18n/ui';
interface Props { events: AreaEvent[] }
const { events } = Astro.props;
const lang = getLang(Astro);
const u = ui[lang];
const locale = lang === 'en' ? 'en-US' : htmlLang[lang];
const tz = 'America/New_York';
const day = new Intl.DateTimeFormat(locale, { timeZone: tz, month: 'short', day: 'numeric' });
const clock = new Intl.DateTimeFormat(locale, { timeZone: tz, weekday: 'long', hour: 'numeric', minute: '2-digit' });
---
{events.length > 0 ? (
  <ul class="events prose">
    {events.map((e) => (
      <li>
        <time datetime={e.start.toISOString()}>{day.format(e.start)}</time>
        <div>
          <a href={e.url}>{e.title}</a>
          <p class="when">{e.allDay ? u.allDay : clock.format(e.start)}{e.venue ? `, ${e.venue}` : ''}</p>
        </div>
      </li>
    ))}
  </ul>
) : (
  <p class="prose">{u.noEventsShort}</p>
)}
