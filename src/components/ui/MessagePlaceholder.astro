---
// "Send a message to <who>" form, not functional yet. Falls back to the plain email address.
import PlaceholderForm from './PlaceholderForm.astro';
import { getLang, fmt } from '../../i18n';
import { ui } from '../../i18n/ui';
interface Props { id: string; to: string; email: string }
const { id, to, email } = Astro.props;
const u = ui[getLang(Astro)];
---
<PlaceholderForm
  id={id}
  submitLabel={fmt(u.formSendTo, { to })}
  alternative={{ text: u.formReachToday, href: `mailto:${email}`, label: email }}
  fields={[
    { name: 'name', label: u.formName, required: true },
    { name: 'email', label: u.formEmail, type: 'email', required: true },
    { name: 'message', label: u.formMessage, type: 'textarea', required: true },
  ]}
/>
