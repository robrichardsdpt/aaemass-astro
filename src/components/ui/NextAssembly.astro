---
// "The next Area Assembly" card: date, place, and one line on what this kind of Assembly is for.
import { getAllEvents } from '../../lib/all-events';
import { assemblyKind, nextAssembly } from '../../lib/next-assembly';
import { getLang, htmlLang, lp } from '../../i18n';
import { assemblyKinds } from '../../i18n/assembly-kinds';
import Callout from './Callout.astro';

interface Props { title?: string }
const lang = getLang(Astro);
const event = nextAssembly(await getAllEvents());
const locale = lang === 'en' ? 'en-US' : htmlLang[lang];
const when = event && new Intl.DateTimeFormat(locale, { timeZone: 'America/New_York', weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' }).format(new Date(event.start));

const words = {
  en: {
    heading: 'The next Area Assembly',
    none: 'The next Assembly has not been posted yet. Dates appear on the calendar as soon as a host district confirms them.',
    calendar: 'See the calendar',
    details: 'Details and directions',
  },
  es: {
    heading: 'La próxima Asamblea de Área',
    none: 'La próxima Asamblea aún no se ha publicado. Las fechas aparecen en el calendario en cuanto un distrito anfitrión las confirma.',
    calendar: 'Ver el calendario',
    details: 'Detalles e indicaciones',
  },
  fr: {
    heading: 'La prochaine assemblée de région',
    none: 'La prochaine assemblée n’a pas encore été publiée. Les dates apparaissent au calendrier dès qu’un district hôte les confirme.',
    calendar: 'Voir le calendrier',
    details: 'Détails et itinéraire',
  },
}[lang];
const { title = words.heading } = Astro.props;
const blurb = event ? assemblyKinds[lang][assemblyKind(event.title)] : '';
---
<Callout title={title}>
  <div class="stack prose-body">
    {event ? (
      <>
        <p><strong>{when}</strong><br />{event.title}{event.address ? <><br />{event.address}</> : null}</p>
        {blurb && <p>{blurb}</p>}
        <p><a href={event.detail}>{words.details}</a></p>
      </>
    ) : (
      <>
        <p>{words.none}</p>
        <p><a href={lp(lang, '/calendar/')}>{words.calendar}</a></p>
      </>
    )}
  </div>
</Callout>
