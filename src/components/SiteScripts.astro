---
import BackToTop from './BackToTop.astro';
---

<BackToTop />
<script>
  // Arrived from the site search: highlight the searched words and show the first one.
  if (location.search.includes('q=')) void import('../scripts/find-on-page');
</script>
<script is:inline>
  // Menu is a plain <details>. Keep it open on wide screens (where the summary is hidden)
  // and closed on narrow ones, including when the window is resized after load.
  var menu = document.getElementById('menu');
  var wide = matchMedia('(min-width: 60rem)');
  function syncMenu() { if (menu) menu.open = wide.matches; }
  syncMenu();
  wide.addEventListener('change', syncMenu);
  // Overlay behavior on phones: Escape or a tap outside closes it.
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && menu && menu.open && !wide.matches) { menu.open = false; menu.querySelector('summary').focus(); }
  });
  document.addEventListener('click', function (e) {
    if (menu && menu.open && !wide.matches && !menu.contains(e.target)) menu.open = false;
  });
  // Sticky header: compact it once the page is scrolled. The gap between the two limits stops it flickering
  // when the shrinking header itself shifts the page by a few pixels.
  var root = document.documentElement;
  function syncScrolled() {
    var y = window.scrollY;
    if (!root.hasAttribute('data-scrolled') && y > 80) root.setAttribute('data-scrolled', '');
    else if (root.hasAttribute('data-scrolled') && y < 20) root.removeAttribute('data-scrolled');
  }
  syncScrolled();
  addEventListener('scroll', syncScrolled, { passive: true });
  // The header's real height (it changes with text size, language and when compacted) keeps the phone menu on screen
  // and stops jumped-to headings hiding under the header.
  var header = document.querySelector('.site-header');
  if (header && 'ResizeObserver' in window) {
    new ResizeObserver(function () { root.style.setProperty('--header-h', header.offsetHeight + 'px'); }).observe(header);
  }
  // Menu groups are dropdowns on wide screens: only one open at a time, closed by Escape or a tap outside.
  // (On phones they stay open until tapped again, so the whole menu can be browsed.)
  var groups = Array.prototype.slice.call(document.querySelectorAll('.nav-group'));
  groups.forEach(function (g) {
    g.addEventListener('toggle', function () {
      if (g.open && wide.matches) groups.forEach(function (o) { if (o !== g) o.open = false; });
    });
  });
  document.addEventListener('keydown', function (e) {
    if (e.key !== 'Escape' || !wide.matches) return;
    groups.forEach(function (g) { if (g.open) { g.open = false; g.querySelector('summary').focus(); } });
  });
  document.addEventListener('click', function (e) {
    if (!wide.matches) return;
    groups.forEach(function (g) { if (g.open && !g.contains(e.target)) g.open = false; });
  });
  // Language menu closes on Escape or a tap outside.
  var langMenu = document.getElementById('lang-menu');
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && langMenu && langMenu.open) { langMenu.open = false; langMenu.querySelector('summary').focus(); }
  });
  document.addEventListener('click', function (e) {
    if (langMenu && langMenu.open && !langMenu.contains(e.target)) langMenu.open = false;
  });
  // Light/dark toggle. The inline head script applies the saved choice before first paint.
  var toggle = document.getElementById('theme-toggle');
  function currentTheme() {
    return document.documentElement.dataset.theme ||
      (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
  }
  function labelToggle() {
    var next = currentTheme() === 'dark' ? 'light' : 'dark';
    toggle.setAttribute('aria-label', next === 'dark' ? toggle.dataset.toDark : toggle.dataset.toLight);
  }
  // The browser's address-bar tint follows the page's theme, including a choice made with the toggle.
  function syncThemeColor() {
    if (!document.documentElement.dataset.theme) return;
    document.querySelectorAll('meta[name="theme-color"]').forEach(function (m) {
      m.removeAttribute('media');
      m.setAttribute('content', currentTheme() === 'dark' ? '#0a1420' : '#f9fafc');
    });
  }
  syncThemeColor();
  if (toggle) {
    labelToggle();
    toggle.addEventListener('click', function () {
      var next = currentTheme() === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch (e) {}
      labelToggle();
      syncThemeColor();
    });
  }
  // Back-to-top button: shown after scrolling about one screen.
  var toTop = document.getElementById('to-top');
  if (toTop) {
    var ticking = false;
    function syncToTop() {
      ticking = false;
      toTop.toggleAttribute('data-visible', window.scrollY > Math.max(400, innerHeight));
    }
    addEventListener('scroll', function () {
      if (!ticking) { ticking = true; requestAnimationFrame(syncToTop); }
    }, { passive: true });
    syncToTop();
    toTop.addEventListener('click', function () {
      var calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
      scrollTo({ top: 0, behavior: calm ? 'auto' : 'smooth' });
      // The button hides once the page is at the top, so keyboard focus moves to the first link instead of being lost.
      var first = document.querySelector('.skip-link');
      if (first) first.focus({ preventScroll: true });
    });
  }
</script>
