---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import { path, site } from '../lib/site';
import { getLang, lp, alternates, locales, langName, htmlLang } from '../i18n';
import { ui } from '../i18n/ui';
import seal from '../assets/seal.png';

interface Props { current?: string }
const { current } = Astro.props;
const lang = getLang(Astro);
const u = ui[lang];
// "@documents" in the menu settings is the Area 30 documents folder (an external link with its own translated label).
const nav = ((await getEntry('settings', 'navigation'))?.data.items ?? []).map((i) =>
  i.url === '@documents'
    ? { label: u.docs, href: site.links.areaFolder }
    : { label: u.nav[i.url] ?? i.label, href: i.url.startsWith('/') ? lp(lang, i.url) : i.url },
);
// Same page in the other languages; pages without a translation link to that language's home page.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const here = Astro.url.pathname.startsWith(base) ? Astro.url.pathname.slice(base.length) || '/' : Astro.url.pathname;
const alts = alternates(here);
// The WordPress plugin package contains only the English home page, so it has no other languages to link to.
const showSwitcher = !base.includes('/wp-content/');
const switcher = locales.map((l) => ({ l, href: path(alts[l] ?? (l === 'en' ? '/' : `/${l}/`)), current: l === lang }));
---

<header class="site-header">
  <div class="wrap">
    <a class="brand" href={lp(lang, '/')}>
      <Image src={seal} width={56} height={51} alt="" loading="eager" />
      <span>{u.brand[0]}<br />{u.brand[1]}</span>
    </a>
    {showSwitcher && <nav class="lang-switch" aria-label={u.language}>
      <details id="lang-menu">
        <summary>
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3z"/></svg>
          <span lang={htmlLang[lang]}>{langName[lang]}</span>
        </summary>
        <ul>
          {switcher.map((x) => (
            <li><a href={x.href} lang={htmlLang[x.l]} hreflang={htmlLang[x.l]} aria-current={x.current ? 'true' : undefined}>{langName[x.l]}</a></li>
          ))}
        </ul>
      </details>
    </nav>}
    <button class="theme-toggle" type="button" id="theme-toggle" aria-label={u.themeToggle} data-to-light={u.switchToLight} data-to-dark={u.switchToDark}>
      <svg class="icon-sun" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      <svg class="icon-moon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
    </button>
    <nav class="site-nav" aria-label={u.mainNav}>
      <details id="menu">
        <summary>{u.menu}</summary>
        <ul>
          {nav.map((item) => <li><a href={item.href} aria-current={current === item.href ? 'page' : undefined}>{item.label}</a></li>)}
        </ul>
      </details>
    </nav>
  </div>
</header>
