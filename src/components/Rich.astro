---
// Renders a plain string, turning the first mention of each defined term into a popover.
import Term from './Term.astro';
import { termRegex, termIdFor } from '../lib/term-match';

interface Props {
  text: string;
  seen: Set<string>;
}
const { text, seen } = Astro.props;
const parts = text.split(termRegex);
---

{parts.map((part, i) => {
  const id = i % 2 === 1 ? termIdFor(part) : undefined;
  return id ? <Term id={id} seen={seen}>{part}</Term> : part;
})}
