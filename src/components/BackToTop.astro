---
// A round button that appears once the visitor has scrolled down a screen or so, and returns them to the top of the page.
import { getLang } from '../i18n';
import { ui } from '../i18n/ui';

const u = ui[getLang(Astro)];
---

<button class="to-top" type="button" id="to-top" aria-label={u.backToTop}>
  <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
</button>
