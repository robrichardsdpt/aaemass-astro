---
import { site } from '../lib/site';
---

<footer class="site-footer">
  <div class="wrap">
    <div class="stack">
      <h2 style="font-size: var(--step-1)">Area 30 committee meetings</h2>
      <p>
        The committee meets {site.meeting.when} at the
        <a href={site.meeting.map}>{site.meeting.where}</a>.
      </p>
    </div>
    <address class="stack">
      <p><strong>Alcoholics Anonymous General Service Committee of Eastern Massachusetts</strong></p>
      <p>
        {site.address.street}<br />
        {site.address.city}, {site.address.region} {site.address.postalCode}
      </p>
      <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
    </address>
    <p class="legal">
      Join us on the broad highway. &copy; {new Date().getFullYear()} Area 30, Eastern Mass. Alcoholics Anonymous.
      Links to other websites are provided as a convenience only; Area 30 does not manage or control them.
    </p>
  </div>
</footer>
