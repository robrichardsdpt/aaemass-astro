---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import { site } from '../lib/site';
import { getLang, htmlLang, ogLocale, resolve, isIndexable, seoAlternates, locales } from '../i18n';
import { ui } from '../i18n/ui';
import heroImg from '../assets/boston-2-bg.jpg';
import sealImg from '../assets/seal.png';
import publicSans from '@fontsource-variable/public-sans/files/public-sans-latin-wght-normal.woff2?url';
import sourceSerif from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  faqs?: { q: string; a: string }[];
  noindex?: boolean;
  crumbs?: { name: string; href: string }[];
  extraLd?: Record<string, unknown>[];
}
const { title, description, faqs = [], noindex: pageNoindex = false, crumbs = [], extraLd = [] } = Astro.props;
// The GitHub Pages preview must not compete with the real site in search results.
const lang = getLang(Astro);
const u = ui[lang];
const noindexUnreviewed = (() => {
  const r = resolve(Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/');
  return lang !== 'en' && !(r && isIndexable(r.key, lang));
})();
const noindex = pageNoindex || noindexUnreviewed || Boolean(import.meta.env.PUBLIC_NOINDEX);
// Strip the build base (the WordPress plugin path) so canonical URLs are the public ones.
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const publicPath = Astro.url.pathname.startsWith(basePath) ? Astro.url.pathname.slice(basePath.length) || '/' : Astro.url.pathname;
const canonical = new URL(publicPath, site.url).href;

const og = await getImage({ src: heroImg, width: 1200, height: 630, format: 'jpeg', quality: 70 });
// The logo in the structured data (Google wants at least 112px). The browser tab and home-screen icons are in public/ (scripts/make-icons.mjs).
const logo = await getImage({ src: sealImg, width: 256, format: 'webp', quality: 80 });
const abs = (path: string) => new URL(path, site.url).href;
const alts = noindex ? {} : seoAlternates(publicPath);
const withBase = (p: string) => abs(p);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${site.url}/#website`,
      url: site.url,
      name: site.name,
      inLanguage: ['en-US', 'es-US', 'fr-FR'],
      publisher: { '@id': `${site.url}/#org` },
    },
    {
      '@type': 'NGO',
      '@id': `${site.url}/#org`,
      name: site.name,
      alternateName: lang === 'en' ? ui.en.siteAlternate : [ui.en.siteAlternate, u.siteName],
      url: site.url,
      email: site.email,
      logo: abs(logo.src),
      image: abs(og.src),
      description,
      ...(site.sameAs.length ? { sameAs: site.sameAs } : {}),
      memberOf: { '@type': 'Organization', name: 'Alcoholics Anonymous World Services', url: 'https://www.aa.org/' },
      areaServed: { '@type': 'AdministrativeArea', name: 'Eastern Massachusetts' },
      address: {
        '@type': 'PostalAddress',
        streetAddress: site.address.street,
        addressLocality: site.address.city,
        addressRegion: site.address.region,
        postalCode: site.address.postalCode,
        addressCountry: 'US',
      },
      contactPoint: { '@type': 'ContactPoint', contactType: 'general inquiries', email: site.email },
    },
    ...(faqs.length
      ? [{
          '@type': 'FAQPage',
          '@id': `${canonical}#faq`,
          mainEntity: faqs.map((f) => ({
            '@type': 'Question',
            name: f.q,
            acceptedAnswer: { '@type': 'Answer', text: f.a },
          })),
        }]
      : []),
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: title,
      inLanguage: htmlLang[lang],
      description,
      isPartOf: { '@id': `${site.url}/#website` },
      about: { '@id': `${site.url}/#org` },
      primaryImageOfPage: abs(og.src),
      dateModified: new Date().toISOString().slice(0, 10),
      ...(crumbs.length ? { breadcrumb: { '@id': `${canonical}#breadcrumb` } } : {}),
    },
    ...(crumbs.length
      ? [{
          '@type': 'BreadcrumbList',
          '@id': `${canonical}#breadcrumb`,
          itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: new URL(c.href, site.url).href })),
        }]
      : []),
    ...extraLd,
  ],
};
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Forms may only submit to this site; no <base> tricks; no plugins.
         (Only directives that work in a meta tag. Set frame-ancestors / full script-src as real headers if the host allows.) -->
    <meta http-equiv="Content-Security-Policy" content="form-action 'self'; base-uri 'none'; object-src 'none'" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {Object.entries(alts).length > 1 && Object.entries(alts).map(([l, p]) => <link rel="alternate" hreflang={htmlLang[l as keyof typeof htmlLang]} href={withBase(p)} />)}
    {alts.en && Object.entries(alts).length > 1 && <link rel="alternate" hreflang="x-default" href={withBase(alts.en)} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={u.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="color-scheme" content="light dark" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <meta property="og:locale" content={ogLocale[lang]} />
    {locales.filter((l) => l !== lang && alts[l]).map((l) => <meta property="og:locale:alternate" content={ogLocale[l]} />)}
    <meta property="og:image" content={abs(og.src)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={u.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={abs(og.src)} />
    <meta name="twitter:image:alt" content={u.ogImageAlt} />
    <script is:inline>
      try {
        var t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} sizes="48x48" />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />
    <link rel="preload" href={publicSans} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sourceSerif} as="font" type="font/woff2" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">{u.skip}</a>
    <slot />
  </body>
</html>
