---
import Base from './Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteScripts from '../components/SiteScripts.astro';
import { Image } from 'astro:assets';
import heroImg from '../assets/boston-2-bg.jpg';
import { path } from '../lib/site';

interface Props {
  title: string;
  description: string;
  heading: string;
  eyebrow?: string;
  lede?: string;
  current?: string;
}
const { title, description, heading, eyebrow, lede, current } = Astro.props;
---

<Base title={title} description={description}>
  <SiteHeader current={current ? path(current) : undefined} />
  <main id="main">
    <section class="hero hero--compact" aria-labelledby="hero-title">
      <Image src={heroImg} alt="" widths={[640, 1024, 1600]} sizes="100vw" quality={55} loading="eager" fetchpriority="high" />
      <div class="wrap">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h1 id="hero-title">{heading}</h1>
        {lede && <p class="lede">{lede}</p>}
        <slot name="actions" />
      </div>
    </section>
    <slot />
  </main>
  <SiteFooter />
  <SiteScripts />
</Base>
