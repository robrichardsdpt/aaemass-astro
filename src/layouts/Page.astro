---
import Base from './Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteScripts from '../components/SiteScripts.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { Image } from 'astro:assets';
import heroImg from '../assets/boston-2-bg.jpg';
import { path } from '../lib/site';
import { getLang, lp, lpPublic } from '../i18n';
import { ui } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  heading: string;
  eyebrow?: string;
  lede?: string;
  current?: string;
  // Visible FAQ section, also emitted as FAQPage structured data. Answers must be plain text.
  faqs?: { q: string; a: string }[];
  extraLd?: Record<string, unknown>[];
  // Set false when the page renders its own FAQ blocks (the faqs still become structured data).
  showFaqs?: boolean;
  noindex?: boolean;
  // Breadcrumb trail between Home and this page.
  trail?: { name: string; href: string }[];
}
const lang = getLang(Astro);
const u = ui[lang];
const { title, description, heading, eyebrow, lede, current, faqs = [], extraLd = [], trail = [], showFaqs = true, noindex = false } = Astro.props;
const here = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const crumbs = [{ name: u.home, href: lpPublic(lang, '/') }, ...trail.map((t) => ({ ...t, href: lpPublic(lang, t.href) })), { name: heading, href: here }];
---

<Base title={title} description={description} faqs={faqs} crumbs={crumbs} extraLd={extraLd} noindex={noindex}>
  <SiteHeader current={current ? lp(lang, current) : undefined} />
  <main id="main">
    <Breadcrumbs heading={heading} trail={trail} />
    <section class="hero hero--compact" aria-labelledby="hero-title">
      <Image src={heroImg} alt="" widths={[640, 1024, 1600]} sizes="100vw" quality={55} loading="eager" fetchpriority="high" />
      <div class="wrap">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h1 id="hero-title">{heading}</h1>
        {lede && <p class="lede">{lede}</p>}
        <slot name="actions" />
      </div>
    </section>
    <slot />
    {showFaqs && faqs.length > 0 && (
      <section class="section" aria-labelledby="faq-title">
        <div class="wrap prose">
          <h2 id="faq-title" style="margin-block-end: var(--s-5)">{u.faqHeading}</h2>
          <div class="faq">
            {faqs.map((f) => (
              <details>
                <summary>{f.q}</summary>
                <div class="stack"><p>{f.a}</p></div>
              </details>
            ))}
          </div>
        </div>
      </section>
    )}
  </main>
  <SiteFooter />
  <SiteScripts />
</Base>
