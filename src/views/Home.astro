---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { site } from '../lib/site';
import { featuredCommittees, listedCommittees } from '../lib/committee-pages';
import { getUpcomingEvents, localizeEvents } from '../lib/events';
import Msg from '../components/Msg.astro';
import Rich from '../components/Rich.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteScripts from '../components/SiteScripts.astro';
import LiveFormScript from '../components/ui/LiveFormScript.astro';
import { getLang, lp, pick, fmt, htmlLang } from '../i18n';
import { ui } from '../i18n/ui';
import { home } from '../i18n/pages/home';
import { committeeNames } from '../i18n/committees';

import heroImg from '../assets/boston-2-bg.jpg';
import circleImg from '../assets/shutterstock_1555828898.png';
import handsImg from '../assets/shutterstock_1710141808.png';
import archives from '../assets/home-archives.jpg';
import cpc from '../assets/home-cpc.jpg';
import corrections from '../assets/home-corrections.jpg';
import grapevine from '../assets/home-grapevine.jpg';
import literature from '../assets/home-literature.jpg';
import pi from '../assets/home-pi.jpg';

const lang = getLang(Astro);
const u = ui[lang];
const m = pick(home, lang);
const names = committeeNames[lang];
const vars = { registrarEmail: site.registrarEmail, email: site.email, registerForm: site.links.registerForm, when: u.meetingWhen, where: u.meetingWhere };
const faqs = m.faqs.map((f) => ({ ...f, a: fmt(f.a, vars) }));
const linkTo = (to: string) => (to === 'findMeeting' ? site.links.findMeeting : to === 'registerForm' ? site.links.registerForm : lp(lang, to));

const committeeImages = { archives, cpc, corrections, grapevine, literature, pi };

const seen = new Set<string>();
const events = await localizeEvents(await getUpcomingEvents(4), lang);
const tz = 'America/New_York';
const locale = lang === 'en' ? 'en-US' : htmlLang[lang];
const day = new Intl.DateTimeFormat(locale, { timeZone: tz, month: 'short', day: 'numeric' });
const clock = new Intl.DateTimeFormat(locale, { timeZone: tz, weekday: 'long', hour: 'numeric', minute: '2-digit' });
---

<Base title={m.title} description={m.description} faqs={faqs}>
  <SiteHeader />

  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <Image src={heroImg} alt="" widths={[640, 1024, 1600]} sizes="100vw" quality={55} loading="eager" fetchpriority="high" />
      <div class="wrap">
        <p class="eyebrow">{m.eyebrow}</p>
        <h1 id="hero-title">{m.h1}</h1>
        <p class="lede">{m.lede}</p>
        <div class="actions">
          <a class="button" href={site.links.findMeeting}>{m.findMeeting}</a>
          <a class="button button--quiet" href={lp(lang, '/calendar')}>{m.seeCalendar}</a>
          <a class="button button--quiet" href={site.links.areaFolder}>{u.areaDocs}</a>
        </div>
      </div>
    </section>

    <section class="signup" aria-labelledby="signup-title">
      <div class="wrap">
        <div>
          <h2 id="signup-title">{m.signup.title}</h2>
          <p>{m.signup.text}</p>
        </div>
        {site.formsEndpoint ? (
          <form id="signup-form" data-live-form data-kind="signup" data-endpoint={site.formsEndpoint} novalidate
            data-invalid={m.signup.toastInvalid} data-ok={m.signup.toastOk} data-error={m.signup.toastErr}
            data-sending={ui[lang].formSending}>
            <input type="hidden" name="lang" value={lang} />
            <div class="field">
              <label for="signup-email">{m.signup.emailLabel}</label>
              <input id="signup-email" type="email" name="email" autocomplete="email" maxlength="254" required />
            </div>
            <button class="button" type="submit">{m.signup.submit}</button>
            <div class="hp" aria-hidden="true">
              <label>{m.signup.hp}<input type="text" name="_gotcha" value="" tabindex="-1" autocomplete="off" /></label>
            </div>
            <p class="form-status" data-status role="status" aria-live="polite" hidden></p>
            <LiveFormScript />
          </form>
        ) : (
          <p class="form-fallback">{m.signup.altText} <a href={`mailto:${site.email}?subject=${encodeURIComponent(m.signup.mailSubject)}`}>{site.email}</a>.</p>
        )}
      </div>
    </section>

    <section class="section" aria-labelledby="about-title">
      <div class="wrap split">
        <Image src={circleImg} alt={m.about.imageAlt} widths={[480, 731]} sizes="(min-width: 52rem) 40vw, 100vw" />
        <div class="stack prose">
          <h2 id="about-title">{m.about.title}</h2>
          <p><strong>{m.about.strong}</strong></p>
          <p><Msg text={m.about.p1} seen={seen} /></p>
          <p>{m.about.p2}</p>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="register-title">
      <div class="wrap prose">
        <div class="notice stack">
          <h3 id="register-title">{m.register.title}</h3>
          <p>{m.register.p1}</p>
          <p><Msg text={m.register.p2} vars={vars} /></p>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="website-title">
      <div class="wrap split split--flip">
        <Image src={handsImg} alt={m.website.imageAlt} widths={[480, 731]} sizes="(min-width: 52rem) 45vw, 100vw" />
        <div class="stack prose">
          <h2 id="website-title">{m.website.title}</h2>
          <p><Msg text={m.website.p1} seen={seen} /></p>
          <p><Msg text={m.website.p2} vars={vars} /></p>
          <p>
            <a class="button button--quiet" href={site.links.areaFolder}>{m.website.button}</a>
          </p>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="service-title">
      <div class="wrap">
        <div class="stack prose" style="margin-block-end: var(--s-6)">
          <p class="eyebrow">{m.service.eyebrow}</p>
          <h2 id="service-title">{m.service.title}</h2>
          <p>{m.service.intro}</p>
        </div>
        <ul class="paths">
          <li>
            <h3>{m.service.groups.title}</h3>
            <p>{m.service.groups.text}</p>
            <a href={site.links.findMeeting}>{m.service.groups.link}<span class="visually-hidden">{m.service.groups.hidden}</span></a>
          </li>
          <li>
            <h3>{m.service.service.title}</h3>
            <p>{m.service.service.text}</p>
            <a href={lp(lang, '/service')}>{m.service.service.link}</a>
          </li>
          <li>
            <h3>{m.service.what.title}</h3>
            <p>{m.service.what.text}</p>
            <a href={lp(lang, '/alcoholics-anonymous')}>{m.service.what.link}</a>
          </li>
        </ul>
      </div>
    </section>

    <section class="section" aria-labelledby="events-title">
      <div class="wrap prose">
        <div class="section-head">
          <h2 id="events-title">{m.events.title}</h2>
          <a href={lp(lang, '/calendar')}>{m.events.all}</a>
        </div>
        {events.length > 0 ? (
          <ul class="events">
            {events.map((e) => (
              <li>
                <time datetime={e.start.toISOString()}>{day.format(e.start)}</time>
                <div>
                  <a href={e.url}>{e.title}</a>
                  <p class="when">{e.allDay ? u.allDay : clock.format(e.start)}{e.venue ? `, ${e.venue}` : ''}</p>
                </div>
              </li>
            ))}
          </ul>
        ) : (
          <p>{m.events.none}</p>
        )}
      </div>
    </section>

    <section class="section" aria-labelledby="committees-title">
      <div class="wrap">
        <div class="section-head">
          <h2 id="committees-title">{m.committees.title}</h2>
          <a href={lp(lang, '/service')}>{m.committees.all}</a>
        </div>
        <ul class="committee-grid">
          {featuredCommittees.map((c) => (
            <li>
              <Image src={committeeImages[c.tileImage!]} alt="" widths={[200, 300, 400]} sizes="(min-width: 64rem) 11rem, (min-width: 36rem) 30vw, 46vw" />
              <a href={lp(lang, `/committees/${c.slug}`)}>{names[c.slug].tile}</a>
            </li>
          ))}
        </ul>
        <p class="eyebrow" style="margin-block: var(--s-6) var(--s-2)">{m.committees.also}</p>
        <ul class="inline-list">
          {listedCommittees.map((c) => <li><a href={lp(lang, `/committees/${c.slug}`)}>{names[c.slug].name}</a></li>)}
        </ul>
      </div>
    </section>

    <section class="section" aria-labelledby="how-title">
      <div class="wrap">
        <div class="stack prose" style="margin-block-end: var(--s-6)">
          <h2 id="how-title">{m.how.title}</h2>
          <p>{m.how.intro}</p>
        </div>
        <ol class="steps">
          {m.steps.map((step) => (
            <li>
              <h3>{step.title}</h3>
              <p><Rich text={step.text} seen={seen} /></p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section" aria-labelledby="faq-title">
      <div class="wrap prose">
        <h2 id="faq-title" style="margin-block-end: var(--s-5)">{u.faqHeading}</h2>
        <div class="faq">
          {faqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <div class="stack">
                <p><Rich text={f.a} seen={seen} /></p>
                {f.link && <p><a href={linkTo(f.link.to)}>{f.link.text}</a></p>}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>
    <section class="section" aria-labelledby="quick-title">
      <div class="wrap">
        <h2 id="quick-title" class="visually-hidden">{m.quick.title}</h2>
        <div class="quick">
          <div class="stack">
            <h3>{m.quick.events.title}</h3>
            <p>{m.quick.events.text}</p>
            <a href={lp(lang, '/calendar')}>{m.quick.events.link}</a>
          </div>
          <div class="stack">
            <h3>{m.quick.contact.title}</h3>
            <p>{m.quick.contact.text}</p>
            <a href={lp(lang, '/contact')}>{m.quick.contact.link}</a>
          </div>
          <div class="stack">
            <h3>{m.quick.seventh.title}</h3>
            <p>{m.quick.seventh.text}</p>
            <a href={lp(lang, '/contribute')}>{m.quick.seventh.link}</a>
          </div>
          <div class="stack">
            <h3>{m.quick.links.title}</h3>
            <p>{m.quick.links.text}</p>
            <a href={lp(lang, '/resources')}>{m.quick.links.link}</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />


  <SiteScripts />
</Base>
