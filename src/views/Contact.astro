---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteScripts from '../components/SiteScripts.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Msg from '../components/Msg.astro';
import LiveFormScript from '../components/ui/LiveFormScript.astro';
import { site } from '../lib/site';
import { getLang, lp, lpPublic, pick } from '../i18n';
import { ui } from '../i18n/ui';
import { contact } from '../i18n/pages/contact';
import { committeeNames } from '../i18n/committees';
import heroImg from '../assets/boston-2-bg.jpg';

const lang = getLang(Astro);
const m = pick(contact, lang);
const u = ui[lang];
const names = committeeNames[lang];
const mail = (user: string) => `${user}@aaemass.org`;

const officerUsers = ['delegate', 'altdelegate', 'chair', 'altchair', 'secretary', 'treasurer'];
const officers = officerUsers.map((user, i) => ({ role: m.officers[i], user }));
const conferenceCommittees = [
  { slug: 'archives', user: 'archives' },
  { slug: 'cpc', user: 'cpc' },
  { slug: 'corrections', user: 'corrections' },
  { slug: 'grapevine', user: 'grapevine' },
  { slug: 'literature', user: 'literature' },
  { slug: 'public-information', user: 'pi' },
  { slug: 'treatment-facilities', user: 'treatment' },
  { slug: 'accessibilities', user: 'accessibilities' },
].map((c) => ({ name: names[c.slug].name, label: names[c.slug].label, user: c.user }));
const standingCommittees = [
  { slug: 'state-convention', user: 'mastateconvention' },
  { slug: 'messenger', user: 'messenger' },
  { slug: 'registrar', user: 'registrar' },
  { slug: 'service-seminar', user: 'serviceseminar' },
  { slug: 'technology', user: 'technology' },
  { slug: 'website', user: 'website' },
].map((c) => ({ name: names[c.slug].name, label: names[c.slug].label, user: c.user }));
const contactPoints = [
  { contactType: m.general, email: site.email },
  ...officers.map((o) => ({ contactType: o.role, email: mail(o.user) })),
  ...conferenceCommittees.map((c) => ({ contactType: c.label, email: mail(c.user) })),
  ...standingCommittees.map((c) => ({ contactType: c.label, email: mail(c.user) })),
].map((c) => ({ '@type': 'ContactPoint', ...c }));
const extraLd = [{ '@type': 'NGO', '@id': `${site.url}/#org`, contactPoint: contactPoints }];
const crumbs = [{ name: u.home, href: lpPublic(lang, '/') }, { name: m.crumb, href: lpPublic(lang, '/contact/') }];
---

<Base crumbs={crumbs} extraLd={extraLd} title={m.title} description={m.description}>
  <SiteHeader current={lp(lang, '/contact')} />

  <main id="main">
    <Breadcrumbs heading={m.crumb} />
    <section class="hero hero--compact" aria-labelledby="hero-title">
      <Image src={heroImg} alt="" widths={[640, 1024, 1600]} sizes="100vw" quality={55} loading="eager" fetchpriority="high" />
      <div class="wrap">
        <p class="eyebrow">{m.eyebrow}</p>
        <h1 id="hero-title">{m.h1}</h1>
        <p class="lede">{m.lede}</p>
        <div class="actions">
          <a class="button" href="#contact-form">{m.sendMessage}</a>
          <a class="button button--quiet" href={site.links.findMeeting}>{m.findNear}</a>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="general-title">
      <div class="wrap">
        <h2 id="general-title" class="visually-hidden">{m.generalHidden}</h2>
        <div class="contact-cards">
          <div class="notice stack">
            <h3>{m.emailTitle}</h3>
            <p>{m.emailText}</p>
            <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
          </div>
          <div class="notice stack">
            <h3>{m.postalTitle}</h3>
            <address class="stack">
              <p>
                {u.addressOrg}<br />
                {site.address.street}<br />
                {site.address.city}, {site.address.region} {site.address.postalCode}
              </p>
            </address>
          </div>
          <div class="notice stack">
            <h3>{m.meetingTitle}</h3>
            <p>
              {u.meetingWhen}<br />
              <a href={site.meeting.map}>{u.meetingWhere}</a>
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="officers-title">
      <div class="wrap">
        <div class="stack prose" style="margin-block-end: var(--s-6)">
          <p class="eyebrow">{m.officersEyebrow}</p>
          <h2 id="officers-title">{m.officersTitle}</h2>
          <p>{m.officersText}</p>
        </div>
        <ul class="directory">
          {officers.map((o) => (
            <li>
              <h3>{o.role}</h3>
              <a href={`mailto:${mail(o.user)}`}>{mail(o.user)}</a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section" aria-labelledby="conference-title">
      <div class="wrap">
        <div class="stack prose" style="margin-block-end: var(--s-6)">
          <h2 id="conference-title">{m.conferenceTitle}</h2>
          <p>{m.conferenceText}</p>
        </div>
        <ul class="directory">
          {conferenceCommittees.map((c) => (
            <li>
              <h3>{c.name}</h3>
              <a href={`mailto:${mail(c.user)}`}>{mail(c.user)}</a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section" aria-labelledby="standing-title">
      <div class="wrap">
        <div class="stack prose" style="margin-block-end: var(--s-6)">
          <h2 id="standing-title">{m.standingTitle}</h2>
          <p>{m.standingText}</p>
        </div>
        <ul class="directory">
          {standingCommittees.map((c) => (
            <li>
              <h3>{c.name}</h3>
              <a href={`mailto:${mail(c.user)}`}>{mail(c.user)}</a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section" aria-labelledby="form-title">
      <div class="wrap split">
        <div class="stack prose">
          <h2 id="form-title">{m.formTitle}</h2>
          <p><Msg text={m.formText} vars={{ findMeeting: site.links.findMeeting }} /></p>
        </div>
        {site.formsEndpoint ? (
          <form id="contact-form" class="contact-form" data-live-form data-kind="message" data-endpoint={site.formsEndpoint} novalidate
            data-invalid={m.toastEmail} data-ok={m.toastOk} data-error={m.toastErr} data-sending={u.formSending}>
            <input type="hidden" name="to" value={site.email.split('@')[0]} />
            <input type="hidden" name="lang" value={lang} />
            <div class="field">
              <label for="cf-name">{m.name}</label>
              <input id="cf-name" type="text" name="name" autocomplete="name" maxlength="100" required />
            </div>
            <div class="field">
              <label for="cf-email">{m.email}</label>
              <input id="cf-email" type="email" name="email" autocomplete="email" maxlength="254" required />
            </div>
            <div class="field">
              <label for="cf-reason">{m.reason}</label>
              <select id="cf-reason" name="reason">
                {m.reasons.map((r) => <option value={r}>{r}</option>)}
              </select>
            </div>
            <div class="field">
              <label for="cf-notes">{m.notes}</label>
              <textarea id="cf-notes" name="message" rows="5" maxlength="4000" required></textarea>
            </div>
            <div class="hp" aria-hidden="true">
              <label>{m.hp}<input type="text" name="_gotcha" value="" tabindex="-1" autocomplete="off" /></label>
            </div>
            <div><button class="button" type="submit">{m.submit}</button></div>
            <p class="form-status" data-status role="status" aria-live="polite" hidden></p>
            <LiveFormScript />
          </form>
        ) : (
          <p class="form-fallback">{m.altText} <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
        )}
      </div>
    </section>
  </main>

  <SiteFooter />


  <SiteScripts />
</Base>
