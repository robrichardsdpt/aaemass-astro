---
import Page from '../layouts/Page.astro';
import ExtraSections from '../components/ExtraSections.astro';
import { linkify } from '../lib/links';
import Msg from '../components/Msg.astro';
import { committees } from '../lib/committee-pages';
import { termify } from '../lib/term-match';
import { getLang, lp, fmt } from '../i18n';
import { getService } from '../lib/editable-pages';
import { committeeNames } from '../i18n/committees';

const lang = getLang(Astro);
const seen = new Set<string>();


const m = getService(lang);
const en = getService('en');

// Short, stable anchors that the committee tiles on the home and committees pages link to (English titles).
const ids: Record<string, string> = {
  'Cooperation with the Professional Community': 'cpc',
  'Public Information Committee': 'public-information',
  'Joint Treatment Facilities': 'treatment-facilities',
};
const idOf = (title: string) => ids[title] ?? title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
// Anchors come from the English titles, so they are the same in every language.
const sections = m.sections.map((s, i) => ({ ...s, id: idOf(en.sections[i].title) }));
const names = committeeNames[lang];
const rich = (p: string) => termify(linkify(p), seen, lang);
---

<Page title={m.title} description={m.description} heading={m.heading} eyebrow={m.eyebrow} lede={m.lede} current="/committees">
  <section class="section" aria-labelledby="intro-title">
    <div class="wrap prose stack">
      <h2 id="intro-title" class="visually-hidden">{m.aboutHidden}</h2>
      <p>{m.intro1}</p>
      <p><Msg text={m.intro2} /></p>
      <nav aria-label={lang === 'en' ? 'On this page' : lang === 'es' ? 'En esta página' : 'Sur cette page'} class="stack">
        <p class="eyebrow">{m.jump}</p>
        <ul class="inline-list">
          {sections.map((s) => <li><a href={`#${s.id}`}>{s.title}</a></li>)}
        </ul>
      </nav>
    </div>
  </section>

  {sections.map((s) => (
    <section class="section anchor" id={s.id} aria-labelledby={`${s.id}-title`}>
      <div class="wrap prose stack">
        <h2 id={`${s.id}-title`}>{s.title}</h2>
        {s.paras.map((p) =>
          p.startsWith('@en:') ? <p lang="en" set:html={linkify(p.slice(4))} /> : <p set:html={rich(p)} />,
        )}
        {s.paras.some((p) => p.startsWith('@en:')) && <p class="eyebrow">{m.quoteNote}</p>}
        {(s.id in committees || s.id === 'registrar') && (
          <p><a href={lp(lang, s.id === 'registrar' ? '/committees/registrar' : `/committees/${s.id}`)}>{fmt(m.full, { title: lang === 'en' ? s.title : (names[s.id]?.label ?? s.title) })}</a></p>
        )}
        {s.contact && (
          <p><a class="button button--quiet" href={`mailto:${s.contact}`}>{fmt(m.email, { email: s.contact })}</a></p>
        )}
      </div>
    </section>
  ))}
<ExtraSections page="service" />
</Page>
