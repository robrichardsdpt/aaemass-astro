---
import { Image } from 'astro:assets';
import Page from '../layouts/Page.astro';
import CommitteeTile from '../components/CommitteeTile.astro';
import CommitteeCard from '../components/CommitteeCard.astro';
import Msg from '../components/Msg.astro';
import { featuredCommittees, listedCommittees, committees } from '../lib/committee-pages';
import { getLang, lp, pick } from '../i18n';
import { committeesIndex } from '../i18n/pages/committeesIndex';
import { committeeNames } from '../i18n/committees';
import { committeeText } from '../i18n/pages/committees';
import { getRegistrar } from '../lib/editable-pages';
import archives from '../assets/home-archives.jpg';
import cpc from '../assets/home-cpc.jpg';
import corrections from '../assets/home-corrections.jpg';
import grapevine from '../assets/home-grapevine.jpg';
import literature from '../assets/home-literature.jpg';
import pi from '../assets/home-pi.jpg';

const lang = getLang(Astro);
const m = pick(committeesIndex, lang);
const names = committeeNames[lang];
const images = { archives, cpc, corrections, grapevine, literature, pi };
---

<Page title={m.title} description={m.description} heading={m.heading} eyebrow={m.eyebrow} lede={m.lede} current="/committees">
  <section class="section" aria-labelledby="conf-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="conf-title">{m.confTitle}</h2>
        <a href={lp(lang, '/service')}>{m.reports}</a>
      </div>
      <ul class="committee-grid">
        {featuredCommittees.map((c) => <CommitteeTile image={images[c.tileImage!]} href={lp(lang, `/committees/${c.slug}`)} name={names[c.slug].tile} />)}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="more-title">
    <div class="wrap">
      <h2 id="more-title" style="margin-block-end: var(--s-4)">{m.moreTitle}</h2>
      <ul class="ccard-grid">
        {listedCommittees.map((c) => <CommitteeCard href={lp(lang, `/committees/${c.slug}`)} name={names[c.slug].name} text={(c.slug === 'registrar' ? getRegistrar(lang).lede : lang === 'en' ? committees[c.slug]?.lede : committeeText[lang]?.[c.slug]?.lede ?? committees[c.slug]?.lede) || undefined} />)}
      </ul>
      <p class="prose" style="margin-block-start: var(--s-5)"><Msg text={m.email} /></p>
    </div>
  </section>
</Page>
