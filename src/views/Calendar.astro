---
import Page from '../layouts/Page.astro';
import Msg from '../components/Msg.astro';
import Section from '../components/ui/Section.astro';
import EventList from '../components/ui/EventList.astro';
import EventSearch from '../components/EventSearch.astro';
import ExtraSections from '../components/ExtraSections.astro';
import { getCmsEvents } from '../lib/events';
import { getAllEvents } from '../lib/all-events';
import { agenda, chipTime, kindOf, type CalItem } from '../lib/calendar-grid';
import { nyDate } from '../lib/event-model';
import { CALENDAR_ID } from '../lib/gcal';
import { path, site } from '../lib/site';
import { getLang, fmt, htmlLang } from '../i18n';
import { ui } from '../i18n/ui';
import { getCalendar } from '../lib/editable-pages';

const lang = getLang(Astro);
const m = getCalendar(lang);
const c = m.cal;
const u = ui[lang];
const en = lang === 'en';
const locale = en ? 'en-US' : htmlLang[lang];

// Area 30's public Google Calendar. We draw it ourselves from the same events as Explore events (no Google frames), and link to it.
const subscribe = `https://calendar.google.com/calendar/u/0?cid=${btoa(CALENDAR_ID).replace(/=+$/, '')}`;
const ics = `webcal://calendar.google.com/calendar/ical/${encodeURIComponent(CALENDAR_ID)}/public/basic.ics`;
const live = `https://calendar.google.com/calendar/embed?${new URLSearchParams({ src: CALENDAR_ID, ctz: 'America/New_York', ...(en ? {} : { hl: lang }) })}`;

// Highlighted events and the search window are English only for now.
const highlighted = en ? (await getCmsEvents()).sort((a, b) => a.start.getTime() - b.start.getTime()) : [];
const all = await getAllEvents();
// One-off events (assemblies, Alcathons, the Conference) each have their own page. Linking them here is what lets crawlers find them.
const special = en ? all.filter((e) => e.slug).map((e) => ({ title: e.title, url: e.detail, start: new Date(e.start), allDay: e.allDay, venue: e.venue })) : [];

// The next 30 days as a list, in the page itself: what crawlers and people without JavaScript see, and the whole calendar on phones.
const items: CalItem[] = all.map((e) => ({ id: e.id, title: e.title, start: e.start, end: e.end, allDay: e.allDay, source: e.source, venue: e.venue, recurring: Boolean(e.recurring), href: e.detail }));
const today = nyDate(new Date());
const days = agenda(items, today, 30);
const twoWeeks = nyDate(new Date(Date.now() + 14 * 86_400_000));
// A repeating date has no page of its own: it opens in the Explore events window, which is English only.
const linked = (i: CalItem) => en || !i.href.includes('#e=');
const dayName = new Intl.DateTimeFormat(locale, { timeZone: 'UTC', weekday: 'long', month: 'long', day: 'numeric' });
const stamp = `${new Intl.DateTimeFormat(locale, { timeZone: 'America/New_York', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }).format(new Date())} ET`;
---

<Page title={m.title} description={m.description} heading={m.heading} eyebrow={m.eyebrow} lede={m.lede} faqs={m.faqs} current="/calendar">
  <div slot="actions" class="actions">
    {en && <button type="button" class="button" data-es-open aria-haspopup="dialog">Explore events</button>}
    <a class={en ? 'button button--quiet' : 'button'} href={subscribe}>{m.subscribe}</a>
  </div>

  {en && highlighted.length > 0 && (
    <Section id="highlighted" title="Highlighted events" narrow>
      <EventList events={highlighted} />
    </Section>
  )}
  <section class="section" aria-labelledby="calendar-title">
    <div class="wrap">
      <h2 id="calendar-title" class="visually-hidden">{m.calendarHeading}</h2>
      <ul class="cal-legend" aria-label={c.legend}>
        <li class="k-district"><span class="cal-legend__swatch"></span>{c.kindDistrict}</li>
        <li class="k-committee"><span class="cal-legend__swatch"></span>{c.kindCommittee}</li>
        <li class="k-event"><span class="cal-legend__swatch"></span>{c.kindEvent}</li>
      </ul>
      <div class="cal">
        <div
          class="cal-month" id="cal-month" aria-busy="true"
          data-src={path('/events/calendar.json')} data-history={path('/events/calendar-history.json')} data-page={path('/calendar/')} data-lang={lang} data-locale={locale}
          data-prev={c.prev} data-next={c.next} data-today={c.today} data-more={c.more} data-less={c.less} data-all-day={u.allDay} data-failed={c.failed} data-close={u.close} data-day-open={c.dayOpen}
        >
          <noscript><p class="cal-note">{c.failed}</p></noscript>
        </div>
        <div class="cal-agenda">
          <h3 class="cal-agenda__title">{c.comingUp}</h3>
          {days.length === 0 && <p>{c.nothing}</p>}
          <div class="cal-groups">
          {days.map((d) => (
            <div class:list={['cal-daygroup', d.ymd >= twoWeeks && 'cal-daygroup--later']}>
              <h4 class="cal-dayhead"><time datetime={d.ymd}>{dayName.format(new Date(`${d.ymd}T12:00:00Z`))}</time>{d.ymd === today && <span class="cal-today-tag">{c.today}</span>}</h4>
              <ul class="cal-list">
                {d.items.map((i) => (
                  <li class={`k-${kindOf(i)}`}>
                    <span class="cal-time">{i.allDay ? u.allDay : chipTime(i.start, locale)}</span>
                    <span class="cal-what">{linked(i) ? <a href={i.href}>{i.title}</a> : i.title}{i.venue ? <span class="cal-where">{i.venue}</span> : null}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
          </div>
          {en && <p class="cal-more"><button type="button" class="button button--quiet" data-es-open aria-haspopup="dialog">Explore all events</button></p>}
        </div>
      </div>
      <p class="cal-note">
        <strong>{c.addTitle}:</strong> <a href={subscribe}>Google Calendar</a> · <a href={ics}>{c.addApple}</a>
        <span class="cal-note__sep"> · </span>{fmt(c.updated, { when: stamp })} · <a href={live}>{c.live}</a>
      </p>
      <p class="prose" style="margin-block-start: var(--s-4)">
        <Msg text={m.meets} vars={{ when: u.meetingWhen, where: `[${u.meetingWhere}](${site.meeting.map})` }} />
      </p>
    </div>
  </section>
  {en && <EventSearch />}
  {special.length > 0 && (
    <Section id="special-events" title="Special events" narrow>
      <EventList events={special} />
    </Section>
  )}
  <ExtraSections page="calendar" />

  <script>
    import '../scripts/calendar-month';
  </script>
</Page>
