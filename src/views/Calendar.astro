---
import Page from '../layouts/Page.astro';
import Msg from '../components/Msg.astro';
import Section from '../components/ui/Section.astro';
import EventList from '../components/ui/EventList.astro';
import EventSearch from '../components/EventSearch.astro';
import { getCmsEvents } from '../lib/events';
import { getAllEvents } from '../lib/all-events';
import { site } from '../lib/site';
import { getLang } from '../i18n';
import { ui } from '../i18n/ui';
import { getCalendar } from '../lib/editable-pages';

const lang = getLang(Astro);
const m = getCalendar(lang);
const u = ui[lang];

// Area 30's public Google Calendar (the same one embedded on aaemass.org/cal).
const calendarId = 'Y19lNDBlMzBmZmQ1ZWI5MjMwYzZiOTlhZGJmNDA4YjUwZGNiMGFjNzIyYjQ5ZDIzNmY5NThkMjg2NWViOWRmYWJkQGdyb3VwLmNhbGVuZGFyLmdvb2dsZS5jb20';
const embed = (mode: 'AGENDA' | 'MONTH') =>
  `https://calendar.google.com/calendar/embed?${new URLSearchParams({
    height: '700', wkst: '1', ctz: 'America/New_York', mode, showTitle: '0', showPrint: '0', showTz: '0', src: atob(calendarId), color: '#1d4ed8',
    ...(lang === 'en' ? {} : { hl: lang }),
  })}`;
const subscribe = `https://calendar.google.com/calendar/u/0?cid=${calendarId}`;

// Highlighted events, the search and the "coming up" list are English only for now.
const en = lang === 'en';
const highlighted = en ? (await getCmsEvents()).sort((a, b) => a.start.getTime() - b.start.getTime()) : [];
// The next few events from the Google and WordPress calendars as plain links: the Google embed below is an iframe, so this
// is what crawlers and people without JavaScript see. The full list is in the search window.
// One-off events (assemblies, Alcathons, the Conference) each have their own page. Linking them here is what lets crawlers find them.
const special = en
  ? (await getAllEvents()).filter((e) => e.slug).map((e) => ({ title: e.title, url: e.detail, start: new Date(e.start), allDay: e.allDay, venue: e.venue }))
  : [];
const upcoming = en
  ? (await getAllEvents()).filter((e) => e.source !== 'highlight').slice(0, 10).map((e) => ({ title: e.title, url: e.detail, start: new Date(e.start), allDay: e.allDay, venue: e.venue }))
  : [];
import ExtraSections from '../components/ExtraSections.astro';
---

<Page title={m.title} description={m.description} heading={m.heading} eyebrow={m.eyebrow} lede={m.lede} faqs={m.faqs} current="/calendar">
  <div slot="actions" class="actions">
    {en && <button type="button" class="button" data-es-open aria-haspopup="dialog">Explore events</button>}
    <a class={en ? 'button button--quiet' : 'button'} href={subscribe}>{m.subscribe}</a>
  </div>

  {en && highlighted.length > 0 && (
    <Section id="highlighted" title="Highlighted events" narrow>
      <EventList events={highlighted} />
    </Section>
  )}
  <section class="section" aria-labelledby="calendar-title">
    <div class="wrap">
      <h2 id="calendar-title" class="visually-hidden">{m.calendarHeading}</h2>
      <div class="calendar-frame">
        <iframe class="calendar-agenda" title={m.agendaTitle} src={embed('AGENDA')} loading="lazy"></iframe>
        <iframe class="calendar-month" title={m.monthTitle} src={embed('MONTH')} loading="lazy"></iframe>
      </div>
      <p class="prose" style="margin-block-start: var(--s-4)">
        <Msg text={m.meets} vars={{ when: u.meetingWhen, where: `[${u.meetingWhere}](${site.meeting.map})` }} />
      </p>
    </div>
  </section>
  {en && <EventSearch />}
  {special.length > 0 && (
    <Section id="special-events" title="Special events" narrow>
      <EventList events={special} />
    </Section>
  )}
  {upcoming.length > 0 && (
    <Section id="coming-up" title="Coming up" narrow>
      <EventList events={upcoming} />
    </Section>
  )}
<ExtraSections page="calendar" />
</Page>
